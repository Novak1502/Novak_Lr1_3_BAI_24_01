<Window x:Class="Novak_Lr1_3_BAI_24_01.View.WindowNewEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Height="350" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Код:" Margin="10"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Id}" Width="150" IsReadOnly="True" HorizontalAlignment="Left" Margin="0,8,0,0"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Должность:" Margin="10"/>
        <ComboBox x:Name="CbRole" Grid.Row="1" Grid.Column="1" Width="150" 
                  DisplayMemberPath="NameRole"
                  SelectedValue="{Binding Path=RoleId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Id" HorizontalAlignment="Left" Margin="0,8,0,0"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Фамилия:" Margin="10"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LastName}" Width="150" HorizontalAlignment="Left" Margin="0,8,0,0"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Имя:" Margin="10"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FirstName}" Width="150" HorizontalAlignment="Left" Margin="0,8,0,0"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Дата рождения:" Margin="10"/>
        <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding Birthday}" Width="150" HorizontalAlignment="Left" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Сохранить" Width="100" Margin="5" Click="Save_Click"/>
            <Button Content="Отменить" Width="100" Margin="5" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>