<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!-- 1. Обязательное объявление секции Entity Framework. Должно идти первым! -->
	<configSections>
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
	</configSections>

	<!-- 2. Строка подключения к базе данных -->
	<connectionStrings>
		<add name="CompanyEntities"
			 connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=Novak_Lr1_3_BAI_24_01.CompanyEntities;Integrated Security=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<!-- 3. Настройки запуска приложения (версия .NET) -->
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<!-- 4. Настройки для Entity Framework (фабрика и провайдеры) -->
	<entityFramework>
		<defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
			<parameters>
				<parameter value="mssqllocaldb" />
			</parameters>
		</defaultConnectionFactory>
		<providers>
			<provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>

</configuration>