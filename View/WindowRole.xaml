<Window x:Class="Novak_Lr1_3_BAI_24_01.View.WindowRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Должности" Height="400" Width="500">
    <StackPanel Background="#FFD8D8D8">
        <Label Margin="5" HorizontalAlignment="Center">Список должностей сотрудников</Label>
        <StackPanel Orientation="Horizontal" Background="#FFE4E9E0">
            <Button Content="Добавить" Height="25" Width="100" Margin="10,10,5,10"
                    Command="{Binding AddRole}"/>
            <Button Content="Редактировать" Height="25" Width="100" Margin="10,10,5,10"
                    Command="{Binding EditRole}"/>
            <Button Content="Удалить" Height="25" Width="100" Margin="10,10,5,10"
                    Command="{Binding DeleteRole}"/>
        </StackPanel>
        <ListView ItemsSource="{Binding ListRole}"
                  SelectedItem="{Binding SelectedRole}"
                  Background="#FFD3CDCD">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Код" Width="60"
                                        DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Наименование должности" Width="250"
                                        DisplayMemberBinding="{Binding NameRole}"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>